{
    "name": "kejubayer/pathao-api-integration",
    "description": "Laravel Pathao Courier API integration package for creating orders, delivery price calculation, parcel tracking, merchant stores, and webhook status updates.",
    "type": "library",
    "keywords": [
        "pathao",
        "pathao courier",
        "pathao api",
        "pathao courier api",
        "pathao laravel",
        "pathao package",
        "pathao integration",
        "pathao merchant api",
        "pathao parcel tracking",
        "pathao webhook",
        "pathao delivery charge",
        "laravel courier",
        "laravel delivery",
        "laravel shipping",
        "courier api",
        "delivery api",
        "shipping api",
        "bangladesh courier",
        "bangladesh delivery",
        "courier webhook"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Khondoker Eftakhar Jubayer",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Kejubayer\\PathaoIntegration\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kejubayer\\PathaoIntegration\\PathaoServiceProvider"
            ],
            "aliases": {
                "Pathao": "Kejubayer\\PathaoIntegration\\Facades\\Pathao"
            }
        }
    },
    "require": {
        "php": ">=7.4",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0",
        "guzzlehttp/guzzle": "^7.0"
    }
}
